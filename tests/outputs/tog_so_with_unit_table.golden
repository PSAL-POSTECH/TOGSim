# before the run, in order
[info] [TOGSim] Command line: <path> --config <path> --tog_so <path> --cycle_table <path> --unit_table <path> --log_level trace
[info] [LoadConfig] Loaded configuration file "<path>"
[info] PyTorchSim config:
num_cores: N
core_freq_mhz: N
core_stats_print_period_cycles: N
num_systolic_array_per_core: N
systolic_array_split: round_robin
systolic_array_unit: TPUV6E_MXU
dma_load_latency_cycles: N
dma_load_ready_cycles: N
dma_store_latency_cycles: N
dma_store_ready_cycles: N
vpu_num_lanes: N
vpu_spad_size_kb_per_lane: N
isa: [m, a, f, d, c, v, zvfh, zvfbfmin, zvl256b, vcix_tpuv6e, spad-vector-memory]
vcix: {tpu_mxu_queue_entries: N, tpu_mxu_delay_cycles: N, tpu_xlu_queue_entries: N, tpu_xlu_latency_cycles: N, tpu_xlu_elements_per_cycle: N, tpu_xlu_issue_per_cycle: N, tpu_sfu_latency_cycles: N, tpu_sfu_queue_registers: N}
address_map: {spad_vaddr: <hex>, dram_base: <hex>, dram_size: N}
dram_type: ramulator2
dram_channels: N
dram_stats_print_period_cycles: N
ramulator_config_path: <path>
l2d_type: datacache
l2d_config: S:N:N:N,N,L:T:m:W:L,A:N:N,N:N,N
icnt_type: simple
icnt_latency_cycles: N
icnt_freq_mhz: N
icnt_injection_ports_per_core: N
[info] [Config/Core] core_id: N, partition_id: N (no partition section)
